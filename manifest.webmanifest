{
  "name": "Chat Launcher",
  "short_name": "ChatLauncher",
  "description": "Type a phone number, tap an app, start chatting. WhatsApp, Telegram, Signal, SMS and more — no tracking, works offline.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait-primary",
  "background_color": "#0b1020",
  "theme_color": "#0b1020",
  "categories": ["utilities", "productivity", "communication"],
  "icons": [
    { "src": "./icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "./icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "./icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    {
      "name": "Launch on WhatsApp",
      "short_name": "WhatsApp",
      "url": "./?app=whatsapp",
      "icons": [{ "src": "./icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Launch on Telegram",
      "short_name": "Telegram",
      "url": "./?app=telegram",
      "icons": [{ "src": "./icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Send an SMS",
      "short_name": "SMS",
      "url": "./?app=sms",
      "icons": [{ "src": "./icons/icon-192.png", "sizes": "192x192" }]
    }
  ],
  "share_target": {
    "action": "./",
    "method": "GET",
    "params": { "title": "title", "text": "text" }
  }
}
