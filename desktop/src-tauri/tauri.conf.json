  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJERjg1NkE3MUE0MUE4MDcKUldRSHFFRWFwMWI0dlNXcVBBSE9uL2QyVU9EK3NpN2dvVWY5NmVuL3VMdVRyWTNRVXhTSmpGS2QK",
      "endpoints": [
        "https://github.com/Avithegod2010/chat-launcher/releases/download/desktop-latest/latest.json"
