# Template for the local F-Droid repo config.
#
# The real `fdroid/config.yml` is generated by `.github/workflows/pages.yml`
# at deploy time — the keystore and its passwords come from repository
# secrets and are never committed. Copy this file to `fdroid/config.yml`
# only when you want to run `fdroid update` by hand.
#
# Secret names used by the workflow:
#   FDROID_KEYSTORE_B64   base64 of the PKCS#12 repo keystore
#   FDROID_KEYSTORE_PASS  its store/key password
#
# Back up the keystore and password somewhere safe: every index this repo
# publishes is signed with it, and F-Droid clients pin it on first use.

repo_url: https://avithegod2010.github.io/chat-launcher/fdroid/repo
repo_name: Chat Launcher
repo_description: |-
  Self-hosted builds of Chat Launcher — open any phone number's chat
  directly in WhatsApp, Telegram, Signal, SMS and more.

archive_older: 0

keystore: keystore.p12
repo_keyalias: chatlauncher
keystorepass: change-me
keypass: change-me
