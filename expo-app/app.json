{
  "expo": {
    "name": "Chat Launcher",
    "slug": "avithegoat-project",
    "version": "2.0.0",
    "scheme": "chatlauncher",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0b1020",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0b1020"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "io.github.avithegod2010.chatlauncher",
      "buildNumber": "6",
      "infoPlist": {
        "NSCameraUsageDescription": "Scan QR codes and barcodes that contain phone numbers.",
        "NSContactsUsageDescription": "Pick a contact so you can open their chat without typing the number."
      }
    },
    "android": {
      "package": "io.github.avithegod2010.chatlauncher",
      "versionCode": 6,
      "permissions": [
        "VIBRATE",
        "READ_CONTACTS",
        "POST_NOTIFICATIONS"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#4f46e5",
        "backgroundImage": "./assets/android-icon-background.png",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "avithegod2010.github.io",
              "pathPrefix": "/chat-launcher"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "./plugins/shortcuts-plugin.js",
      "./plugins/tile-plugin.js",
      "expo-share-intent",
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "HomeWidget",
              "label": "Chat Launcher",
              "description": "Your top launch targets — one tap opens the chat.",
              "minWidth": "180dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical"
            }
          ]
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "cef8be3e-19e1-470d-9e2c-6e5c71147652"
      }
    },
    "owner": "avithegoats-team"
  }
}
