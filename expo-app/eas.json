{
  "cli": {
    "appVersionSource": "remote"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      },
      "ios": {
        "autoIncrement": true,
        "image": "latest"
      }
    }
  },
  "submit": {
    "production": {
      "android": {},
      "ios": {
        "appleId": "${env.APPLE_ID}",
        "ascAppId": "${env.ASC_APP_ID}",
        "appleTeamId": "${env.APPLE_TEAM_ID}"
      }
    }
  }
}
